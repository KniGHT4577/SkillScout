# SkillScout AI Backend Environment Variables Example

# Database configuration (Defaults to sqlite+aiosqlite:///./skillscout.db)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/skillscout

# Security settings
SECRET_KEY=supersecretkeythatyoushouldchangeinproduction
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cloud Scheduler Secret Token (Required for triggered tasks)
CRON_SECRET_TOKEN=change-this-in-production-for-cloud-scheduler

# CORS Origins Configuration
# Comma-separated list of allowed origins, or a JSON array string.
# IMPORTANT: In production, explicitly set this to your frontend URL.
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost:8000"]

# API Keys
# TAVILY_API_KEY=your_tavily_api_key
# OPENROUTER_API_KEY=your_openrouter_api_key
